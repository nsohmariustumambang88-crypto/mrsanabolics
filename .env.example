# Copy to .env and fill in. Never commit the real values.
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle and is visible to every
# visitor. Only put values there that are public by design.

# --- Canonical host --------------------------------------------------------------------
# The address search engines should treat as this site's own. It builds every canonical link,
# the sitemap, robots.txt and all structured data, so a wrong value hands the site's pages to
# another domain. Leave it unset on Vercel and the production domain Vercel exposes is used;
# SET IT the day a custom domain goes live, before submitting the site to Google.
# NEXT_PUBLIC_SITE_URL="https://www.example.com"

# --- Live chat agent (optional) -------------------------------------------------------
# With a key, the chat's Agent mode has Claude write its replies from the store's own delivery,
# payment, discount and stock data. Without one, a rule-based agent answers from the same data,
# so the chat works either way. Dosing and medical questions never reach the model.
# ANTHROPIC_API_KEY=""
# Defaults to claude-opus-5. A cheaper model can be named here without a code change.
# CHAT_AGENT_MODEL="claude-opus-5"

# --- Postgres (Supabase) ----------------------------------------------------------------
# From the Supabase project: Connect -> ORMs -> Prisma. Use the POOLER host for both lines, never
# the "direct connection" host (IPv6-only; Vercel cannot reach it). URL-encode the password if it
# contains @ # / ? % (for example @ becomes %40).
#
# Transaction pooler, port 6543, for the running site.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=30&connect_timeout=15"
# Session pooler, port 5432, for `prisma db push`.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# The previous database, read only by `npm run db:import-neon` to copy the live site's records
# across once Neon's quota resets. Delete it after the import.
# NEON_DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# --- Cloudinary ----------------------------------------------------------------------
# Cloud name is public: it appears in every image URL. This alone is enough to SERVE and
# transform images.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"

# Only needed to UPLOAD from the app. The API key is public; the SECRET is not — it must
# never be prefixed NEXT_PUBLIC_, and it is read server-side only (route handlers).
# NEXT_PUBLIC_CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# Gate for /api/upload. Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_UPLOAD_TOKEN=""

# Signing key for admin session cookies (32+ random bytes).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# Marketing consent records hash the subscriber's IP with this salt, as evidence of origin
# without storing the address itself. Any long random string; generate one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Unset is a safe default: the hash is simply omitted rather than falling back to an unsalted
# digest, which for an IPv4 address is reversible by brute force and so is not protection.
SUBSCRIBER_IP_SALT=

# Sign-in for the .impeccable end-to-end harnesses. Real values live in .env, which is
# gitignored. The harnesses refuse to run without these rather than falling back to a
# literal — a password committed to a repo is a password you cannot rotate.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Crypto Payments (NOWPayments) -------------------------------------------------------
# Accept BTC and USDT TRC20 payments via NOWPayments. Get keys from https://nowpayments.io
# API Key: used to create payment charges
NOWPAYMENTS_API_KEY=""
# IPN Secret: used to verify webhook signatures from NOWPayments
NOWPAYMENTS_IPN_SECRET=""

# --- Email (Resend) -----------------------------------------------------------------------
# Send transactional emails (order confirmations, receipts, etc) via Resend
RESEND_API_KEY=""
